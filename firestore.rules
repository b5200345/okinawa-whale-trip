rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/{appId}/public/data/{collectionName}/{docId} {
      allow read: if request.auth != null
        && collectionName in [
          'member_claims',
          'member_checklists',
          'whale_game_scores',
          'member_avatars',
          'member_flights'
        ];
      allow write: if request.auth != null
        && collectionName in [
          'member_claims',
          'member_checklists',
          'whale_game_scores',
          'member_avatars',
          'member_flights'
        ];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
